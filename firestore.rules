rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    match /userDirectory/{email} {
      allow read: if signedIn();
      allow create, update: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && email == request.auth.token.email.lower();
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    // Owned workshop data: settings, printers, filaments, customers, orders,
    // products (saved print catalog), and inbox. Another user cannot read it.
    match /users/{uid}/{document=**} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }

    match /users/{uid}/products/{productId} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }

    match /users/{uid}/inbox/{itemId} {
      allow create: if signedIn()
        && request.auth.uid != uid
        && request.resource.data.senderUid == request.auth.uid
        && request.resource.data.keys().hasAll([
          'type',
          'payloadJson',
          'senderUid',
          'senderName',
          'senderEmail',
          'createdAt'
        ]);
    }
  }
}
